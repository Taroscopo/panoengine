{
  "name": "@panoengine/edge-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:viewer && wrangler dev",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.viewer.json",
    "test": "vitest run",
    "build:viewer": "vite build",
    "build": "pnpm build:viewer && tsc -p tsconfig.worker.json && wrangler deploy --dry-run --outdir dist-worker",
    "test:smoke": "node test/smoke/visor.smoke.mjs"
  },
  "dependencies": {
    "@panoengine/schema": "workspace:*",
    "@photo-sphere-viewer/autorotate-plugin": "^5.7.0",
    "@photo-sphere-viewer/core": "^5.7.0",
    "@photo-sphere-viewer/equirectangular-tiles-adapter": "^5.7.0",
    "@photo-sphere-viewer/gallery-plugin": "^5.7.0",
    "@photo-sphere-viewer/markers-plugin": "^5.7.0",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.7.0",
    "hono": "^4.8.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.0",
    "@types/three": "~0.185.4",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
