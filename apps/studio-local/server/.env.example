# Copia este archivo a .env y rellena tus credenciales locales.
# .env está gitignored: las claves viven SOLO en studio-local (RULES.md §9).

# Puerto del servidor local del estudio
STUDIO_PORT=5175

# Raíz de datos (masters, dist, manifest). Por defecto: <repo>/workspace
# STUDIO_DATA_DIR=/home/leo/Música/360 MOTOR TOURS/workspace

# Cloudflare R2 (API S3) — token con permisos SOLO del bucket panoengine-tours
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key
R2_SECRET_ACCESS_KEY=tu_secret
R2_BUCKET=panoengine-tours
# Endpoint público del Worker (para verificar publicación). Opcional.
EDGE_BASE_URL=
